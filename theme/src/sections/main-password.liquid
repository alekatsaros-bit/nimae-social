<div class="pw">
  <span class="serif" style="font-size:44px;line-height:52px;color:var(--clay)">{{ shop.name }}</span>
  <h1 class="serif" style="margin:0;font-size:clamp(36px,7vw,56px);line-height:1.08">{{ section.settings.heading }}</h1>
  <p class="muted" style="margin:0;max-width:460px">{{ section.settings.text }}</p>
  {%- form 'customer', id: 'pw-signup', style: 'display:flex;flex-wrap:wrap;gap:8px;width:100%;max-width:480px;justify-content:center' -%}
    {%- if form.posted_successfully? -%}
      <p role="status" style="margin:0">Ευχαριστούμε. Θα σας στείλουμε email μόλις ανοίξουμε.</p>
    {%- else -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      <label for="pw-email" class="visually-hidden">Email</label>
      <input id="pw-email" class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="Το email σας" style="flex:1 1 240px;min-width:0">
      <button type="submit" class="btn btn--clay" style="flex:1 1 auto">Γραφτείτε στη λίστα</button>
      {%- if form.errors -%}<p role="alert" style="margin:0;width:100%;font-size:14px">Ελέγξτε το email σας και δοκιμάστε ξανά.</p>{%- endif -%}
    {%- endif -%}
  {%- endform -%}
  <p class="muted" style="margin:0;font-size:12px">Μόνο νέα της Nimaé. Διαγραφή με ένα κλικ.</p>
  {%- if settings.instagram != blank -%}<a href="{{ settings.instagram }}" class="link" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
  <details style="margin-top:32px;font-size:14px">
    <summary class="muted" style="cursor:pointer">Είσοδος καταστηματάρχη</summary>
    {%- form 'storefront_password', style: 'display:flex;gap:8px;margin-top:12px' -%}
      {%- if form.errors -%}<p role="alert" style="margin:0">Λάθος κωδικός.</p>{%- endif -%}
      <label for="pw-pass" class="visually-hidden">Κωδικός</label>
      <input id="pw-pass" class="input" type="password" name="password" autocomplete="current-password" placeholder="Κωδικός">
      <button type="submit" class="btn">Είσοδος</button>
    {%- endform -%}
  </details>
</div>
{% schema %}
{
  "name": "Σελίδα αναμονής",
  "settings": [
    { "type": "text", "id": "heading", "label": "Τίτλος", "default": "Έρχεται σύντομα." },
    { "type": "textarea", "id": "text", "label": "Κείμενο", "default": "Απλά ρούχα από βιολογικό βαμβάκι, με ένα μικρό ν. Γραφτείτε στη λίστα για να μάθετε πρώτοι πότε ανοίγουμε." }
  ]
}
{% endschema %}
