<section style="background:var(--bg3);margin-top:clamp(48px,8vw,80px)" id="newsletter">
  <div style="max-width:720px;margin:0 auto;padding:40px 20px;text-align:center;display:flex;flex-direction:column;gap:14px;align-items:center">
    <h2 class="serif" style="margin:0;font-size:28px;line-height:34px">{{ section.settings.heading }}</h2>
    <p class="muted" style="margin:0">{{ section.settings.text }}</p>
    {%- form 'customer', id: 'newsletter-form', class: 'signup-form' -%}
      {%- if form.posted_successfully? -%}
        <p role="status" style="margin:0;width:100%">Ευχαριστούμε. Είστε στη λίστα.</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="nl-email-{{ section.id }}" class="visually-hidden">Email</label>
        <input id="nl-email-{{ section.id }}" class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="Το email σας" style="flex:1 1 220px;min-width:0;background:var(--bg)">
        <button type="submit" class="btn btn--clay" style="flex:1 1 auto">Εγγραφή</button>
        {%- if form.errors -%}<p role="alert" style="margin:0;width:100%;font-size:14px">Ελέγξτε το email σας και δοκιμάστε ξανά.</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    <p class="muted" style="margin:0;font-size:12px">Μπορείτε να διαγραφείτε οποιαδήποτε στιγμή. <a href="/pages/nomika#privacy" style="text-decoration:underline">Πολιτική απορρήτου</a></p>
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Τίτλος", "default": "Νέα κομμάτια, πρώτα σε εσάς" },
    { "type": "text", "id": "text", "label": "Κείμενο", "default": "Ένα email τον μήνα, χωρίς spam." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
