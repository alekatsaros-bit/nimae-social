{%- assign st = 'width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px;background:#EEE8DC;display:block' -%}
<section class="wrap" style="padding:clamp(40px,7vw,72px) 20px 0">
  <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px">
    {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '/collections/all' }}" style="display:flex;flex-direction:column;gap:10px" {{ block.shopify_attributes }}>
      {% render 'section-image', image: block.settings.image, fallback: block.settings.fallback, alt: '', style: st, sizes: '50vw' %}
      <span style="display:flex;justify-content:space-between;align-items:baseline;gap:8px"><span class="serif" style="font-size:clamp(24px,4vw,40px);line-height:1.1">{{ block.settings.label }}</span>{% render 'icon', name: 'arrow' %}</span>
    </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.banner_title != blank -%}
  <a href="{{ section.settings.banner_link | default: '/collections/paidika' }}" style="margin-top:20px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;padding:24px;border-radius:4px;background:var(--olive);color:var(--bg)">
    <span style="display:flex;flex-direction:column;gap:4px"><span class="serif" style="font-size:28px;line-height:34px">{{ section.settings.banner_title }}</span><span style="font-size:14px">{{ section.settings.banner_text }}</span></span>
    <span style="display:inline-flex;align-items:center;min-height:44px;padding:0 24px;border:1px solid var(--bg);border-radius:4px;font-weight:500;font-size:14px">{{ section.settings.banner_cta }}</span>
  </a>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Γυναικεία / Ανδρικά",
  "settings": [
    { "type": "text", "id": "banner_title", "label": "Λωρίδα: τίτλος", "default": "Παιδικά και βρεφικά" },
    { "type": "text", "id": "banner_text", "label": "Λωρίδα: κείμενο", "default": "Τα ίδια υλικά, σε μικρά μεγέθη." },
    { "type": "text", "id": "banner_cta", "label": "Λωρίδα: κουμπί", "default": "Δείτε τα παιδικά" },
    { "type": "url", "id": "banner_link", "label": "Λωρίδα: σύνδεσμος" }
  ],
  "blocks": [{
    "type": "tile", "name": "Πλακίδιο",
    "settings": [
      { "type": "text", "id": "label", "label": "Όνομα", "default": "Γυναικεία" },
      { "type": "url", "id": "link", "label": "Σύνδεσμος" },
      { "type": "image_picker", "id": "image", "label": "Εικόνα" },
      { "type": "text", "id": "fallback", "label": "Εναλλακτική εικόνα θέματος" }
    ]
  }],
  "max_blocks": 2,
  "presets": [{ "name": "Γυναικεία / Ανδρικά" }]
}
{% endschema %}
