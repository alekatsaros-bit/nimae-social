<section style="max-width:520px;margin:0 auto;padding:clamp(32px,6vw,64px) 20px;display:flex;flex-direction:column;gap:16px">
  <h1 class="h1">Νέος λογαριασμός</h1>
  {%- form 'create_customer', class: 'contact-form' -%}
    {{ form.errors | default_errors }}
    <label class="field">Όνομα<input class="input" type="text" name="customer[first_name]" autocomplete="given-name"></label>
    <label class="field">Επώνυμο<input class="input" type="text" name="customer[last_name]" autocomplete="family-name"></label>
    <label class="field">Email<input class="input" type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="field">Κωδικός<input class="input" type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button class="btn" type="submit">Δημιουργία</button>
  {%- endform -%}
</section>
