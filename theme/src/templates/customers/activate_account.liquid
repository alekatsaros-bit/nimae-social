<section style="max-width:520px;margin:0 auto;padding:clamp(32px,6vw,64px) 20px;display:flex;flex-direction:column;gap:16px">
  <h1 class="h1">Ενεργοποίηση λογαριασμού</h1>
  {%- form 'activate_customer_password', class: 'contact-form' -%}
    {{ form.errors | default_errors }}
    <label class="field">Κωδικός<input class="input" type="password" name="customer[password]" autocomplete="new-password"></label>
    <label class="field">Επιβεβαίωση<input class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password"></label>
    <button class="btn" type="submit">Ενεργοποίηση</button>
  {%- endform -%}
</section>
