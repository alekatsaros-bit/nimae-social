{%- comment -%} Nimaé wordmark: Young Serif. The N is a stem plus the ν from the garments. dark: true on green backgrounds (ν cream). {%- endcomment -%}
{%- liquid
  assign nu_file = 'nu-terra.png'
  if settings.logo_nu_colour == 'green'
    assign nu_file = 'nu-green.png'
  endif
  if dark
    assign nu_file = 'nu-cream.png'
  endif
-%}
<span class="logo-word{% if dark %} logo-word--dark{% endif %}" role="img" aria-label="{{ shop.name }}"{% if size %} style="font-size:{{ size }}"{% endif %}><span class="logo-n" aria-hidden="true">I<img src="{{ nu_file | asset_url }}" alt="" width="100" height="102"></span><span aria-hidden="true">imaé</span></span>
